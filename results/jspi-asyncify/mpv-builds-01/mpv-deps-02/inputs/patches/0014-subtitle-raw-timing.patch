+// Keep every ASS event boundary, including overlapping events with identical
+// plain text but distinct styling. Public sub-lines remains deduplicated.
+static double next_raw_boundary(struct sd *sd, double pts)
+{
+    struct sd_ass_priv *ctx = sd->priv;
+    ASS_Track *track = ctx->ass_track;
+    double next = MP_NOPTS_VALUE;
+    for (int i = 0; i < track->n_events; i++) {
+        ASS_Event *event = &track->events[i];
+        if (!event->Text)
+            continue;
+        double start = event->Start / 1000.0;
+        double end = event->Duration == UNKNOWN_DURATION * 1000
+                   ? MP_NOPTS_VALUE : (event->Start + event->Duration) / 1000.0;
+        if (start > pts && (next == MP_NOPTS_VALUE || start < next))
+            next = start;
+        if (end != MP_NOPTS_VALUE && end > pts &&
+            (next == MP_NOPTS_VALUE || end < next))
+            next = end;
+    }
+    return next;
+}
