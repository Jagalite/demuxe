+
+// Internal numeric timing access; no text is extracted or deduplicated.
+bool sub_next_raw_boundary(struct dec_sub *sub, double pts, double *next)
+{
+    if (!next)
+        return false;
+    mp_mutex_lock(&sub->lock);
+    bool supported = sub->sd->driver->next_raw_boundary != NULL;
+    *next = MP_NOPTS_VALUE;
+    if (supported) {
+        double raw = sub->sd->driver->next_raw_boundary(sub->sd,
+                                                         pts_to_subtitle(sub, pts));
+        if (raw != MP_NOPTS_VALUE)
+            *next = pts_from_subtitle(sub, raw);
+    }
+    mp_mutex_unlock(&sub->lock);
+    return supported;
+}
+
+void sub_set_timing_changed_cb(struct dec_sub *sub, void (*cb)(void *), void *ctx)
+{
+    mp_mutex_lock(&sub->lock);
+    sub->timing_changed = cb;
+    sub->timing_changed_ctx = ctx;
+    mp_mutex_unlock(&sub->lock);
+}
