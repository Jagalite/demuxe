+// The decoded bitmap queue is the rendering source of truth. Packet boundaries
+// and clear packets have already been applied to pts/endpts by decode().
+static int visual_schedule(struct sd *sd, double pts, double *next)
+{
+    struct sd_lavc_priv *priv = sd->priv;
+    if (priv->menu_active ||
+        (priv->avctx->codec_id != AV_CODEC_ID_HDMV_PGS_SUBTITLE &&
+         priv->avctx->codec_id != AV_CODEC_ID_DVD_SUBTITLE))
+        return 0;
+    *next = MP_NOPTS_VALUE;
+    for (int n = 0; n < MAX_QUEUE; n++) {
+        struct sub *sub = &priv->subs[n];
+        if (!sub->valid)
+            continue;
+        if (sub->pts == MP_NOPTS_VALUE)
+            return 0;
+        if (sub->pts > pts && (*next == MP_NOPTS_VALUE || sub->pts < *next))
+            *next = sub->pts;
+        if (sub->endpts != MP_NOPTS_VALUE && sub->endpts > pts &&
+            (*next == MP_NOPTS_VALUE || sub->endpts < *next))
+            *next = sub->endpts;
+    }
+    struct sub *current = get_current(priv, pts);
+    if (current && current->endpts == MP_NOPTS_VALUE &&
+        *next == MP_NOPTS_VALUE)
+        return 0;
+    return 1;
 }
 
