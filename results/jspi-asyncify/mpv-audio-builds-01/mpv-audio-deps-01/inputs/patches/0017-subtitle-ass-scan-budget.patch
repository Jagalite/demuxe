+void sub_static_timing_scan_begin(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    sub->static_scan_active = true;
+    sub->static_scan_overflow = false;
+    sub->static_scan_eof = false;
+    sub->static_scan_packets = 0;
+    sub->static_scan_bytes = 0;
+    mp_mutex_unlock(&sub->lock);
+}
+
+int sub_static_timing_scan_status(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    int status = sub->static_scan_overflow ? -1 : sub->static_scan_eof ? 1 : 0;
+    mp_mutex_unlock(&sub->lock);
+    return status;
+}
+
+void sub_static_timing_scan_end(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    sub->static_scan_active = false;
+    mp_mutex_unlock(&sub->lock);
+}
