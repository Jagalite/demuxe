+// Match the upstream SSE2 gamma LUT on portable Wasm. FFmpeg requests
+// approximate gamma by default; the scalar fallback otherwise evaluates a
+// transcendental function for every component of every output pixel.
+#if defined(__wasm__)
+class ToLinearLutOperationWasm final : public Operation {
+    std::vector<float> m_lut;
+public:
+    ToLinearLutOperationWasm(gamma_func func, float postscale) : m_lut(65537)
+    {
+        for (unsigned i = 0; i <= 65536; ++i)
+            m_lut[i] = func(static_cast<float>(i) / 32768.0f - 0.5f) * postscale;
+    }
+    void process(const float * const *src, float * const *dst, unsigned left, unsigned right) const override
+    {
+        for (unsigned p = 0; p < 3; ++p) {
+            for (unsigned i = left; i < right; ++i) {
+                float x = src[p][i] * 32768.0f + 16384.0f;
+                // SSE2 uses round-to-nearest-even and clamps the LUT index.
+                unsigned index = !std::isfinite(x) || x <= 0.0f ? 0 :
+                    x >= 65536.0f ? 65536 : static_cast<unsigned>(std::nearbyint(x));
+                dst[p][i] = m_lut[index];
+            }
+        }
+    }
+};
+
+class ToGammaLutOperationWasm final : public Operation {
+    std::vector<float> m_lut;
+public:
+    ToGammaLutOperationWasm(gamma_func func, float prescale) : m_lut(65536)
+    {
+        for (uint32_t i = 0; i < 65536; ++i) {
+            uint32_t bits = i << 16;
+            float x;
+            std::memcpy(&x, &bits, sizeof(x));
+            m_lut[i] = func(x * prescale);
+        }
+    }
+    void process(const float * const *src, float * const *dst, unsigned left, unsigned right) const override
+    {
+        for (unsigned p = 0; p < 3; ++p) {
+            for (unsigned i = left; i < right; ++i) {
+                uint32_t bits;
+                std::memcpy(&bits, src[p] + i, sizeof(bits));
+                // Same rounded bfloat16 index and saturation as SSE2.
+                unsigned index = std::min((bits >> 16) + ((bits >> 15) & 1), 65535U);
+                dst[p][i] = m_lut[index];
+            }
+        }
+    }
+};
+#endif
 
