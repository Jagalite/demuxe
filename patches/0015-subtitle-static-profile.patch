+bool sub_static_timing_qualified(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    const char *codec = sub->codec->codec;
+    bool text = codec && (!strcmp(codec, "subrip") ||
+                          !strcmp(codec, "mov_text"));
+    bool ass = codec && (!strcmp(codec, "ass") || !strcmp(codec, "ssa"));
+    bool supported = sub->sd->driver->next_raw_boundary &&
+                     sub->sd->driver->has_animated_events;
+    bool complete = !ass || ((sub->preload_attempted ||
+                             sub->static_full_scan_complete) && sub->sd->preload_ok);
+    bool qualified = supported && (text || ass) && complete &&
+                     !sub->sd->driver->has_animated_events(sub->sd);
+    mp_mutex_unlock(&sub->lock);
+    return qualified;
+}
+
+bool sub_static_timing_ass_preload_needed(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    const char *codec = sub->codec->codec;
+    bool needed = codec && (!strcmp(codec, "ass") || !strcmp(codec, "ssa")) &&
+                  sub->sd->driver->accept_packets_in_advance &&
+                  !sub->preload_attempted && !sub->static_full_scan_complete;
+    mp_mutex_unlock(&sub->lock);
+    return needed;
+}
+
+bool sub_static_timing_mark_full_scan(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+    bool complete = sub->static_scan_eof;
+    if (complete)
+        sub->static_full_scan_complete = true;
+    mp_mutex_unlock(&sub->lock);
+    return complete;
+}
