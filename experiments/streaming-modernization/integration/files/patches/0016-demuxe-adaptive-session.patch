+        if(result<0){pthread_mutex_lock(&t->lock);t->error=result;pthread_mutex_unlock(&t->lock);break;}
+    }
+    pthread_mutex_lock(&t->lock);t->finished=1;pthread_cond_broadcast(&t->changed);pthread_mutex_unlock(&t->lock);return NULL;
